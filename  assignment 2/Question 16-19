USE hr;

SELECT
    FIRST_NAME,
    CASE
        WHEN FIRST_NAME REGEXP '[0-9]'
        THEN 'Contains Number'
        ELSE 'No Number'
    END AS NUMBER_CHECK
FROM EMPLOYEES;
+------------+------------------+
| FIRST_NAME | NUMBER_CHECK     |
+------------+------------------+
| Steven     | No Number        |
| Neena      | No Number        |
| Lex        | No Number        |
+------------+------------------+


